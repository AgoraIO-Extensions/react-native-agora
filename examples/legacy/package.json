{
  "name": "react-native-agora-example-legacy",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:android": "cd android && ./gradlew assembleRelease --no-daemon --console=plain",
    "build:ios": "cd ios && fastlane gym --export_method \"development\" --export_options \"{\\\"compileBitcode\\\":false}\" CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO",
    "test:android": "cd android && ./gradlew connectedReleaseAndroidTest -DtestBuildType=release --no-daemon --console=plain",
    "build:test:ios": "ruby ../../scripts/configure-ios-ui-tests.rb ios AgoraRtcNgExample && xcodebuild -workspace ios/AgoraRtcNgExample.xcworkspace -scheme AgoraDemoSmokeTests -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build build-for-testing CODE_SIGN_IDENTITY=- ONLY_ACTIVE_ARCH=YES",
    "test:ios": "python3 ../../scripts/run-ios-ui-tests.py ios/build/Build/Products ios/test-results"
  },
  "dependencies": {
    "@react-native-community/slider": "^4.5.5",
    "@react-native-picker/picker": "^2.11.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@react-navigation/stack": "^7.1.1",
    "@rneui/base": "^4.0.0-rc.8",
    "@rneui/themed": "^4.0.0-rc.8",
    "react": "18.3.1",
    "react-native": "0.77.1",
    "react-native-awesome-slider": "^2.9.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-color-picker": "^0.6.0",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.24.0",
    "react-native-image-tool": "https://github.com/AgoraIO-Extensions/react-native-image-tools/archive/7ffc05ec3a6976b605c307942986a289ab4f47ef.tar.gz",
    "react-native-picker-select": "^9.3.1",
    "react-native-reanimated": "3.17.5",
    "react-native-safe-area-context": "^5.2.0",
    "react-native-screens": "^4.6.0",
    "react-native-svg": "^15.11.1",
    "react-native-vector-icons": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.77.1",
    "@react-native/eslint-config": "0.77.1",
    "@react-native/metro-config": "0.77.1",
    "babel-plugin-module-resolver": "^5.0.0",
    "pod-install": "^0.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
